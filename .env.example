# ─────────────────────────────────────────────────────────────
# PR-Warden environment template.
# Copy to .env — NEVER commit .env or .secrets/ (gitignored).
# ─────────────────────────────────────────────────────────────

# ── GitHub App (created by setup; leave blank for guided setup) ──
GITHUB_APP_ID=
GITHUB_APP_NAME=pr-warden
WEBHOOK_SECRET=

# ── Runtime ──────────────────────────────────────────────────────
PORT=3000
PYTHONIOENCODING=utf-8
PYTHONUTF8=1

# ── Model: pick one backend ─────────────────────────────────────
# Local (Ollama) — default
WARDEN_MODEL=ollama/qwen2.5-coder:14b
OLLAMA_API_BASE=http://127.0.0.1:11434

# Cloud (optional; uncomment the one you use)
# WARDEN_MODEL=gpt-4o
# OPENAI_API_KEY=
# WARDEN_MODEL=anthropic/claude-sonnet-4
# ANTHROPIC_API_KEY=
# WARDEN_MODEL=gemini/gemini-2.0-flash
# GEMINI_API_KEY=

# ── Tunnel ───────────────────────────────────────────────────────
# tailscale-funnel (recommended, permanent URL) | ngrok | none
TUNNEL_PROVIDER=tailscale-funnel
NGROK_DOMAIN=
