# ----------------------------------------------------------------------------
# PR-Warden configuration (example). Copy to config/warden.toml and edit.
# NEVER commit real secrets.
#
# What actually reads this file:
#   [model] preset  -> `warden` CLI default preset (CLI flag and WARDEN_PRESET
#                      env var win over this file)
#   [server] port   -> `warden health` / `warden server` default port (PORT env wins)
#
# Everything else (GitHub App credentials, model backend, webhook secret) is
# runtime configuration supplied via .env / environment / docker-compose --
# see .env.example. Keep secrets out of this file.
# ----------------------------------------------------------------------------

[model]
# Presets: local-fast | local-thinking | openai | claude | gemini | custom
preset = "local-fast"

[server]
port = 3000
